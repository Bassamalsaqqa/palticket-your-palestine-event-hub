// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum OrganizationRole {
  ADMIN
  STAFF
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  PENDING
  ISSUED
  SCANNED
  VOID
}

enum ScanResult {
  GRANTED
  DENIED_ALREADY_USED
  DENIED_INVALID_EVENT
  DENIED_INVALID_TICKET
  DENIED_PAYMENT_NOT_CONFIRMED
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
}

// -----------------------------------------------------------------------------
// 1. Multi-tenancy & Users
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]
  orders      Order[]
  scans       ScanLog[]
  sentInvites OrganizationInvite[] @relation("SentInvites")
  idempotencyKeys IdempotencyKey[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            OrganizationMember[]
  invites            OrganizationInvite[]
  venues             Venue[]
  events             Event[]
  gates              Gate[]
  orders             Order[]
  tickets            Ticket[]
  scanLogs           ScanLog[]
  commissionPolicies CommissionPolicy[]
  payouts            Payout[]
  categories         Category[]
  cities             City[]
  idempotencyKeys    IdempotencyKey[]
  ticketInventories  TicketTypeInventory[]
  payments           Payment[]
  auditLogs          AuditLog[]

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  scanLogs     ScanLog[]
  auditLogs    AuditLog[]
  createdPayments Payment[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  token          String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  invitedByUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("SentInvites", fields: [invitedByUserId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([token])
}

// -----------------------------------------------------------------------------
// 2. Taxonomy
// -----------------------------------------------------------------------------

model Category {
  id             String   @id @default(uuid())
  slug           String
  organizationId String?
  isGlobal       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  translations   CategoryTranslation[]
  events         Event[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String
  locale     String
  name       String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model City {
  id             String   @id @default(uuid())
  slug           String
  organizationId String?
  isGlobal       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  translations   CityTranslation[]
  events         Event[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model CityTranslation {
  id      String @id @default(uuid())
  cityId  String
  locale  String
  name    String

  city    City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, locale])
}

// -----------------------------------------------------------------------------
// 3. Events & Venues
// -----------------------------------------------------------------------------

model Venue {
  id             String   @id @default(uuid())
  organizationId String
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id])
  events         Event[]
  translations   VenueTranslation[]

  @@index([organizationId])
}

model VenueTranslation {
  id      String @id @default(uuid())
  venueId String
  locale  String
  name    String
  address String?
  city    String?

  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, locale])
}

model Event {
  id             String    @id @default(uuid())
  organizationId String
  venueId        String?
  categoryId     String?
  cityId         String?
  slug           String
  imageUrl       String?
  startTime      DateTime
  endTime        DateTime?
  status         EventStatus @default(DRAFT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  venue              Venue?             @relation(fields: [venueId], references: [id])
  category           Category?          @relation(fields: [categoryId], references: [id])
  city               City?              @relation(fields: [cityId], references: [id])
  translations       EventTranslation[]
  ticketTypes        TicketType[]
  gates              Gate[]
  orders             Order[]
  tickets            Ticket[]
  scanLogs           ScanLog[]
  commissionPolicies CommissionPolicy[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([venueId])
  @@index([categoryId])
  @@index([cityId])
  @@index([startTime])
  @@index([slug])
}

model EventTranslation {
  id          String  @id @default(uuid())
  eventId     String
  locale      String
  name        String
  description String?
  summary     String?

  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
}

// -----------------------------------------------------------------------------
// 4. Gates
// -----------------------------------------------------------------------------

model Gate {
  id             String @id @default(uuid())
  organizationId String
  eventId        String
  name           String

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  scanLogs     ScanLog[]

  @@index([organizationId])
  @@index([eventId])
}

// -----------------------------------------------------------------------------
// 5. Ticket Economics & Orders
// -----------------------------------------------------------------------------

model TicketType {
  id                String   @id @default(uuid())
  eventId           String
  name              String
  sellPriceCents    Int
  partnerPriceCents Int
  currency          String
  quantity          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id])
  orderItems OrderItem[]
  tickets    Ticket[]
  inventory  TicketTypeInventory?

  @@index([eventId])
}

model TicketTypeInventory {
  id             String   @id @default(uuid())
  organizationId String
  ticketTypeId   String   @unique
  capacity       Int
  sold           Int      @default(0)
  reserved       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])

  @@index([organizationId, ticketTypeId])
}

model Order {
  id               String        @id @default(uuid())
  organizationId   String
  eventId          String
  userId           String
  totalCents       Int
  currency         String
  status           OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus? // Deprecated in favor of Payment model, but kept for migration safety if needed, or remove? Request says "add if missing" for enum values. The model fields for Payment model are specified. I will keep existing fields but maybe they are redundant now. The request says "Payment model + enums... fields: ...". It doesn't explicitly say remove old fields from Order. I'll keep them for now to avoid breaking existing code immediately, or map them. Actually, OrderStatus is updated.
  paymentProvider  String?
  paymentReference String?
  attendeeName     String?
  attendeeEmail    String?
  attendeePhone    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  items        OrderItem[]
  tickets      Ticket[]
  payments     Payment[]
  idempotencyKeys IdempotencyKey[]

  @@index([organizationId])
  @@index([eventId])
  @@index([userId])
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  priceCents   Int

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
}

model Ticket {
  id             String       @id @default(uuid())
  organizationId String
  eventId        String
  orderId        String
  ticketTypeId   String
  code           String       @unique
  status         TicketStatus @default(ISSUED)
  scannedAt      DateTime?
  attendeeName   String?
  attendeeEmail  String?
  attendeePhone  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  scanLogs     ScanLog[]

  @@index([organizationId])
  @@index([eventId])
  @@index([orderId])
  @@index([ticketTypeId])
  @@index([code])
}

// -----------------------------------------------------------------------------
// 6. Scanning & Logs
// -----------------------------------------------------------------------------

model ScanLog {
  id              String     @id @default(uuid())
  organizationId  String
  ticketId        String
  eventId         String?
  scannedAt       DateTime   @default(now())
  scannedByUserId String?
  scannedByMemberId String?
  gateId          String?
  result          ScanResult

  organization Organization     @relation(fields: [organizationId], references: [id])
  ticket       Ticket           @relation(fields: [ticketId], references: [id])
  event        Event?           @relation(fields: [eventId], references: [id])
  scannedBy    User?            @relation(fields: [scannedByUserId], references: [id])
  scannedByMember OrganizationMember? @relation(fields: [scannedByMemberId], references: [id])
  gate         Gate?            @relation(fields: [gateId], references: [id])

  @@index([organizationId])
  @@index([ticketId])
  @@index([eventId])
  @@index([gateId])
  @@index([scannedByUserId])
  @@index([scannedByMemberId])
  @@index([organizationId, scannedAt])
}

// -----------------------------------------------------------------------------
// 7. Finance & Audit
// -----------------------------------------------------------------------------

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  orderId           String
  method            PaymentMethod
  status            PaymentStatus
  amountCents       Int
  currency          String
  provider          String?       // "manual" for phase 1
  providerReference String?
  capturedAt        DateTime?
  createdByMemberId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  createdBy    OrganizationMember? @relation(fields: [createdByMemberId], references: [id])

  @@index([organizationId, createdAt])
  @@index([orderId])
  @@unique([provider, providerReference]) // Only works if both are non-null? Postgres handles nulls in unique index as non-conflicting usually, but Prisma might be stricter. If nullable, maybe standard index is better or partial index. Request said "optional unique". I'll add it.
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorMemberId  String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        OrganizationMember? @relation(fields: [actorMemberId], references: [id])

  @@index([organizationId, createdAt])
}

model CommissionPolicy {
  id             String    @id @default(uuid())
  organizationId String
  eventId        String?
  percentBps     Int
  flatFeeCents   Int?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event?       @relation(fields: [eventId], references: [id])

  @@index([organizationId])
  @@index([eventId])
}

model Payout {
  id              String       @id @default(uuid())
  organizationId  String
  periodStart     DateTime
  periodEnd       DateTime
  grossCents      Int
  commissionCents Int
  netCents        Int
  status          PayoutStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model IdempotencyKey {
  id             String    @id @default(uuid())
  key            String
  organizationId String
  userId         String
  requestMethod  String
  requestPath    String
  requestHash    String
  responseCode   Int
  responseBody   String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  orderId        String?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@unique([organizationId, userId, requestMethod, requestPath, key])
  @@index([createdAt])
}

